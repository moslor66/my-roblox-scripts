-- 2. LOGIKA SCRIPT (0.1s LOOP & SMART AUTO-BUY)
-- ==========================================
local isSpamming = false

CloseBtn.MouseButton1Click:Connect(function()
    isSpamming = false
    ScreenGui:Destroy()
end)

-- FITUR AUTO-BUY & AUTO-STOP (Berjalan di background)
task.spawn(function()
    while task.wait(0.05) do
        if not isSpamming then continue end
        pcall(function()
            local prompt = CoreGui:FindFirstChild("PurchasePrompt")
            if prompt then
                local container = prompt:FindFirstChild("ProductPurchaseContainer")
                if container and container.Visible then
                    local buyBtn = container:FindFirstChild("BuyButton", true)
                    if buyBtn then
                        -- ===================================================
                        -- 🛑 1. HENTIKAN SPAM SEKETIKA
                        -- ===================================================
                        isSpamming = false -- Ini akan otomatis menghentikan loop 0.1s di bawah
                        
                        -- Update tampilan UI
                        SpamBtn.Text = "▶ START SPAM (0.1s DELAY)"
                        SpamBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                        Status.Text = "Status: 🎉 ITEM MUNCUL! Sedang Auto-Buy..."
                        Status.TextColor3 = Color3.fromRGB(50, 255, 255)

                        -- ===================================================
                        -- 🛒 2. KLIK TOMBOL BELI OTOMATIS
                        -- ===================================================
                        VirtualInputManager:SendMouseButtonEvent(
                            buyBtn.AbsolutePosition.X + (buyBtn.AbsoluteSize.X / 2),
                            buyBtn.AbsolutePosition.Y + (buyBtn.AbsoluteSize.Y / 2),
                            0, true, game, 1
                        )
                        task.wait(0.01)
                        VirtualInputManager:SendMouseButtonEvent(
                            buyBtn.AbsolutePosition.X + (buyBtn.AbsoluteSize.X / 2),
                            buyBtn.AbsolutePosition.Y + (buyBtn.AbsoluteSize.Y / 2),
                            0, false, game, 1
                        )
                        
                        Status.Text = "Status: ✅ AUTO-BUY SUKSES DIEKSEKUSI!"
                    end
                end
            end
        end)
    end
end)

-- FITUR SPAM DENGAN JEDA 0.1 DETIK
SpamBtn.MouseButton1Click:Connect(function()
    if isSpamming then
        isSpamming = false
        SpamBtn.Text = "▶ START SPAM (0.1s DELAY)"
        SpamBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        Status.Text = "Status: 🛑 Sniper dihentikan manual."
        Status.TextColor3 = Color3.fromRGB(200, 200, 200)
        return
    end
    
    local rawText = CodeInput.Text
    local remoteName = RemoteInput.Text
    
    if rawText == "" or remoteName == "" then
        Status.Text = "Status: ⚠️ Masukkan kodenya dulu!"
        Status.TextColor3 = Color3.fromRGB(255, 255, 50)
        return
    end

    local targetRemote = ReplicatedStorage:FindFirstChild(remoteName)
    if not targetRemote or not targetRemote:IsA("RemoteFunction") then
        Status.Text = "Status: ❌ RemoteFunction tidak valid!"
        Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    rawText = string.gsub(rawText, "\n", ",")
    local codeList = string.split(rawText, ",")
    local cleanCodes = {}
    
    for _, code in pairs(codeList) do
        local trimmed = string.match(code, "^%s*(.-)%s*$")
        if trimmed ~= "" then
            table.insert(cleanCodes, trimmed)
        end
    end

    if #cleanCodes == 0 then
        return
    end

    isSpamming = true
    SpamBtn.Text = "🛑 STOP SPAM"
    SpamBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    Status.Text = "Status: ⚡ Mengirim request aman (Setiap 0.1 detik)..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    -- LOOP SPAM DENGAN DELAY 0.1 DETIK
    task.spawn(function()
        while isSpamming do
            for _, targetCode in ipairs(cleanCodes) do
                -- Kirim request di thread terpisah agar tidak macet
                task.spawn(function()
                    pcall(function()
                        targetRemote:InvokeServer(targetCode)
                    end)
                end)
            end
            task.wait(0.1) -- Jeda aman yang kamu minta (0.1 detik)
        end
    end)
end)
