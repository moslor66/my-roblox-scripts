-- [[ 2. LOGIKA FITUR TRANSPORT ]]

-- A. INSTANT INTERACT (MAX STEALTH - NO LOOP)
-- Logika ini hanya berjalan saat kamu mulai menekan tombol E (Hold Began), sehingga sangat aman.
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
    if State.Instant and player == lp then
        -- Jika executor kamu mendukung fitur fireproximityprompt (sangat gaib/invisible)
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            -- Fallback aman: Ubah durasi menjadi 0 hanya selama sepersekian detik, lalu kembalikan normal
            local originalHold = prompt.HoldDuration
            prompt.HoldDuration = 0
            task.delay(0.05, function()
                prompt.HoldDuration = originalHold
            end)
        end
    end
end)

-- B. SPEED LARI (DYNAMIC SAFE SPEED)
local originalSpeed = 10 
task.spawn(function()
    while task.wait(0.1) do
        local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
        if hum then 
            if State.Speed then
                -- ON: Speed 14 (Natural, lebih cepat dari default tapi tidak lari)
                if hum.WalkSpeed ~= 14 then
                    if hum.WalkSpeed ~= 14 and hum.WalkSpeed ~= 16 and hum.WalkSpeed ~= 18 and hum.WalkSpeed ~= 21 then
                        originalSpeed = hum.WalkSpeed
                    end
                    hum.WalkSpeed = 14
                end
            else
                -- OFF: Kembali ke kecepatan lambat bawaan game
                if hum.WalkSpeed == 14 or hum.WalkSpeed == 16 or hum.WalkSpeed == 18 or hum.WalkSpeed == 21 then
                    hum.WalkSpeed = originalSpeed
                else
                    originalSpeed = hum.WalkSpeed
                end
            end
        end
    end
end)
