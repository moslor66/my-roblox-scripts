-- [[ 2. LOGIKA FITUR TRANSPORT ]]

-- A. INSTANT INTERACT (ANTI-DETECT BYPASS)
local savedPrompts = {}
task.spawn(function()
    while task.wait(0.5) do
        if State.Instant then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and v.HoldDuration > 0.1 then
                    -- Simpan durasi asli sebelum diubah
                    if not savedPrompts[v] then
                        savedPrompts[v] = v.HoldDuration
                    end
                    -- Gunakan 0.1 agar tidak terdeteksi oleh sistem
                    v.HoldDuration = 0.1
                end
            end
        else
            -- Kembalikan semua durasi ke normal saat dimatikan
            for prompt, originalDuration in pairs(savedPrompts) do
                if prompt and prompt.Parent then
                    prompt.HoldDuration = originalDuration
                end
            end
            table.clear(savedPrompts)
        end
    end
end)

-- B. SPEED LARI (SAFE SPEED)
task.spawn(function()
    while task.wait(0.1) do
        local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
        if hum then 
            -- Speed diatur ke 18 (Standar 16) agar sangat aman
            hum.WalkSpeed = State.Speed and 18 or 16 
        end
    end
end)
