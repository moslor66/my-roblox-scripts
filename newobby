-- [[ 3. LOGIKA FLY (SUPPORT PC & MOBILE/ANALOG) ]]
local flySpeed = 50
local bg, bv

RunService.RenderStepped:Connect(function()
    if State.Fly and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character:FindFirstChild("Humanoid") then
        local root = lp.Character.HumanoidRootPart
        local hum = lp.Character.Humanoid
        
        -- Buat penggerak jika belum ada
        if not bg then
            bg = Instance.new("BodyGyro", root); bg.P = 9e4; bg.maxTorque = Vector3.new(9e9, 9e9, 9e9); bg.cframe = root.CFrame
        end
        if not bv then
            bv = Instance.new("BodyVelocity", root); bv.velocity = Vector3.new(0,0,0); bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        end
        
        -- Sesuaikan arah terbang mengikuti arah kamera dan analog/WASD
        hum.PlatformStand = true
        bg.cframe = Workspace.CurrentCamera.CFrame
        bv.velocity = Workspace.CurrentCamera.CFrame:VectorToWorldSpace(hum.MoveDirection * flySpeed)
        
        -- Jika tidak bergerak, tahan di udara
        if hum.MoveDirection.Magnitude == 0 then
            bv.velocity = Vector3.new(0, 0, 0)
        end
    else
        -- Matikan fly dengan aman
        if bg then bg:Destroy(); bg = nil end
        if bv then bv:Destroy(); bv = nil end
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.PlatformStand = false
        end
    end
end)

-- [[ 4. LOGIKA SKYWALK FIX (ANTI TREADMILL & LUNCUR) ]]
local skyPad = nil

RunService.Heartbeat:Connect(function()
    if State.Skywalk and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local root = lp.Character.HumanoidRootPart
        
        if not skyPad then
            -- Buat lantai yang lebih lebar agar tidak licin
            skyPad = Instance.new("Part"); skyPad.Size = Vector3.new(15, 1, 15)
            skyPad.Anchored = true; skyPad.Transparency = 0.5; skyPad.BrickColor = BrickColor.new("Cyan")
            skyPad.Material = Enum.Material.Glass; skyPad.Parent = Workspace
            
            -- Set ketinggian lantai pas di bawah kaki
            skyPad.Position = Vector3.new(root.Position.X, root.Position.Y - 3.5, root.Position.Z)
        end
        
        -- Hanya update X dan Z agar pemain bisa bergerak bebas, tahan posisi Y
        local padHeight = skyPad.Position.Y
        skyPad.Position = Vector3.new(root.Position.X, padHeight, root.Position.Z)
    else
        if skyPad then skyPad:Destroy(); skyPad = nil end
    end
end)

-- [[ 5. INFINITE JUMP & ANTI-KILL PINTAR ]]
UserInputService.JumpRequest:Connect(function()
    if State.InfJump and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

task.spawn(function()
    while task.wait(1) do
        if State.AntiKill then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local touch = v:FindFirstChildOfClass("TouchTransmitter")
                    if touch then
                        v.CanTouch = false
                        v.Transparency = 0.8
                    end
                end
            end
        end
    end
end)
