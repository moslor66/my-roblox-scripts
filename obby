-- [[ 2. PEMBUAT TOMBOL ]]
local State = { Skywalk = false, AntiKillBrick = false }
local toggleFunctions = {} -- Menyimpan fungsi toggle agar bisa dipanggil lewat keyboard

local function AddToggle(text, stateKey, colorOn)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -10, 0, 35); b.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
    b.Text = text .. " [OFF]"; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamSemibold
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local function Toggle()
        State[stateKey] = not State[stateKey]
        b.Text = text .. (State[stateKey] and " [ON]" or " [OFF]")
        b.BackgroundColor3 = State[stateKey] and colorOn or Color3.fromRGB(40, 45, 55)
    end
    
    b.MouseButton1Click:Connect(Toggle)
    toggleFunctions[stateKey] = Toggle -- Simpan fungsi
    return b
end

AddToggle("☁️ Skywalk [Tombol E]", "Skywalk", Color3.fromRGB(40, 150, 180))
AddToggle("🛡️ Hapus Laser / Jebakan", "AntiKillBrick", Color3.fromRGB(180, 50, 50))

-- [[ 3. FITUR TELEPORT KE TEMAN ]]
local TargetBox = Instance.new("TextBox", Content)
TargetBox.Size = UDim2.new(1, -10, 0, 35)
TargetBox.BackgroundColor3 = Color3.fromRGB(30, 35, 40)
TargetBox.TextColor3 = Color3.new(1,1,1)
TargetBox.Font = Enum.Font.Gotham
TargetBox.PlaceholderText = "Ketik Nama Teman Di Sini..."
TargetBox.Text = ""
Instance.new("UICorner", TargetBox).CornerRadius = UDim.new(0, 6)

local TpBtn = Instance.new("TextButton", Content)
TpBtn.Size = UDim2.new(1, -10, 0, 35)
TpBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 40)
TpBtn.Text = "🚀 Teleport Langsung"
TpBtn.TextColor3 = Color3.new(1,1,1)
TpBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", TpBtn).CornerRadius = UDim.new(0, 6)

TpBtn.MouseButton1Click:Connect(function()
    local targetString = TargetBox.Text:lower()
    if targetString == "" then
        AlertText.Text = "⚠️ Masukkan nama teman dulu!"
        AlertText.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local targetPlayer = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            if p.Name:lower():sub(1, #targetString) == targetString or p.DisplayName:lower():sub(1, #targetString) == targetString then
                targetPlayer = p
                break
            end
        end
    end
    
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = lp.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            myChar.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myChar.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            AlertText.Text = "✅ Berhasil TP ke: " .. targetPlayer.DisplayName
            AlertText.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        AlertText.Text = "❌ Pemain tidak ditemukan/mati!"
        AlertText.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
    
    task.delay(3, function() 
        AlertText.Text = "Status: Siap Digunakan ✅"
        AlertText.TextColor3 = Color3.fromRGB(200, 255, 200)
    end)
end)

-- [[ 4. LOGIKA SKYWALK FIX (ANTI MELAYANG) ]]
local skyPad = nil
local skyHeight = 0 -- Variabel pengunci ketinggian lantai

RunService.RenderStepped:Connect(function()
    if State.Skywalk and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local root = lp.Character.HumanoidRootPart
        
        if not skyPad then
            skyPad = Instance.new("Part"); skyPad.Size = Vector3.new(6, 1, 6); skyPad.Anchored = true
            skyPad.Transparency = 0.5; skyPad.BrickColor = BrickColor.new("Cyan")
            skyPad.Material = Enum.Material.ForceField; skyPad.Parent = Workspace
            
            -- FIX: Kunci ketinggian (Sumbu Y) lantai saat Skywalk baru dinyalakan
            skyHeight = root.Position.Y - 3.5
            
            -- Hentikan momentum jatuh agar karakter mendarat mulus di atas pad
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
        
        -- Pad hanya mengikuti posisi Kiri/Kanan/Maju/Mundur (X dan Z), ketinggiannya (Y) dikunci ke skyHeight
        skyPad.Position = Vector3.new(root.Position.X, skyHeight, root.Position.Z)
    else
        if skyPad then skyPad:Destroy(); skyPad = nil end
    end
end)

-- Hotkey Control
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Abaikan jika sedang ngetik di chat
    
    -- HOTKEY 1: Tombol 'E' untuk ON/OFF Skywalk Instan
    if input.KeyCode == Enum.KeyCode.E then
        if toggleFunctions["Skywalk"] then
            toggleFunctions["Skywalk"]()
            
            -- Jika kita mematikan Skywalk, hapus langsung lantainya agar kita bisa jatuh bebas
            if not State.Skywalk and skyPad then
                skyPad:Destroy()
                skyPad = nil
            end
        end
    end
    
    -- HOTKEY 2 & 3: Tombol 'R' (Naik) dan 'F' (Turun)
    if State.Skywalk and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local root = lp.Character.HumanoidRootPart
        
        if input.KeyCode == Enum.KeyCode.R then 
            skyHeight = skyHeight + 3 -- Naikkan lantai
            root.CFrame = root.CFrame + Vector3.new(0, 3, 0) -- Naikkan karakter
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
            
        elseif input.KeyCode == Enum.KeyCode.F then 
            skyHeight = skyHeight - 3 -- Turunkan lantai
            root.CFrame = root.CFrame - Vector3.new(0, 3, 0) -- Turunkan karakter
            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
    end
end)

-- [[ 5. LOGIKA HAPUS JEBAKAN (ANTI-KILL) ]]
task.spawn(function()
    while task.wait(1) do
        if State.AntiKillBrick then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local touch = v:FindFirstChildOfClass("TouchTransmitter")
                    if touch then
                        v.CanTouch = false
                        v.Transparency = 0.8
                    end
                end
            end
        end
    end
end)
