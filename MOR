-- [[ 2. LOGIKA FITUR TRANSPORT ]]
local State = { Instant = false, Speed = false, Fullbright = false, InfJump = false, Noclip = false }

local function AddToggle(text, stateKey, callback)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -5, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    b.Text = text .. " [OFF]"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseButton1Click:Connect(function()
        State[stateKey] = not State[stateKey]
        b.Text = text .. (State[stateKey] and " [ON]" or " [OFF]")
        b.BackgroundColor3 = State[stateKey] and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(50, 50, 55)
        if callback then callback(State[stateKey]) end
    end)
end

-- A. INSTANT INTERACT (MAX STEALTH)
AddToggle("⚡ Instant Interact", "Instant")
ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
    if State.Instant and player == lp then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            local originalHold = prompt.HoldDuration
            prompt.HoldDuration = 0
            task.delay(0.05, function() prompt.HoldDuration = originalHold end)
        end
    end
end)

-- B. SPEED LARI (Lebih Stabil Menggunakan RunService)
local originalSpeed = 8
AddToggle("🏃 Speed Lari (Aman)", "Speed")
RunService.RenderStepped:Connect(function()
    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
    if hum then
        if State.Speed then
            if hum.WalkSpeed < 14 then
                originalSpeed = hum.WalkSpeed
                hum.WalkSpeed = 14 -- Kecepatan lari normal roblox
            end
        else
            if hum.WalkSpeed == 14 then
                hum.WalkSpeed = originalSpeed
            end
        end
    end
end)

-- C. FULLBRIGHT (Terang Benderang)
local origAmbient, origOutdoorAmbient, origShadows
AddToggle("☀️ Fullbright", "Fullbright", function(isOn)
    if isOn then
        origAmbient = Lighting.Ambient
        origOutdoorAmbient = Lighting.OutdoorAmbient
        origShadows = Lighting.GlobalShadows
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
    else
        if origAmbient then
            Lighting.Ambient = origAmbient
            Lighting.OutdoorAmbient = origOutdoorAmbient
            Lighting.GlobalShadows = origShadows
        end
    end
end)

-- D. INFINITE JUMP (Lompat Berkali-kali)
AddToggle("🦘 Infinite Jump", "InfJump")
UserInputService.JumpRequest:Connect(function()
    if State.InfJump then
        local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- E. NOCLIP (Tembus Tembok)
AddToggle("👻 Noclip", "Noclip")
RunService.Stepped:Connect(function()
    if State.Noclip and lp.Character then
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)
