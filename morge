-- [[ 2. KONFIGURASI STATE & FUNGSI TOMBOL ]]
local State = { Instant = false, Sprint = false, GodMode = false }

local function AddToggle(text, stateKey)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -5, 0, 35); b.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    b.Text = text .. " [OFF]"; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamSemibold
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseButton1Click:Connect(function() 
        State[stateKey] = not State[stateKey]
        b.Text = text .. (State[stateKey] and " [ON]" or " [OFF]")
        b.BackgroundColor3 = State[stateKey] and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(50, 50, 55)
    end)
end

local function AddButton(text, callback)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -5, 0, 35); b.BackgroundColor3 = Color3.fromRGB(180, 80, 40)
    b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamBold
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(callback)
end

-- Render Tombol UI
AddToggle("⚡ Instant Interact (E)", "Instant")
AddToggle("🏃 Sprint Biasa", "Sprint")
AddToggle("🛡️ God Mode (Anti Mati)", "GodMode")

-- Tombol Khusus Spawn Hantu
AddButton("🩸 SPAWN BATTLENURSE", function()
    local cmd = "/spawnplayer " .. lp.Name .. " BattleNurse"
    
    -- Injeksi ke sistem Chat Baru (TextChatService)
    if TextChatService and TextChatService:FindFirstChild("TextChannels") then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(cmd) end
    end
    
    -- Injeksi ke sistem Chat Lama (Legacy Chat)
    local legacyChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
        legacyChat.SayMessageRequest:FireServer(cmd, "All")
    end
    print("Mencoba mengirim perintah Admin: " .. cmd)
end)

-- [[ 3. LOGIKA FITUR ]]

-- A. Instant Interact (Menghilangkan Loading 'E')
task.spawn(function()
    while task.wait(0.5) do
        if State.Instant then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and v.HoldDuration > 0 then
                    v:SetAttribute("OldHold", v.HoldDuration) -- Simpan durasi asli
                    v.HoldDuration = 0 -- Jadikan instan
                end
            end
        else
            -- Kembalikan seperti semula jika dimatikan
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and v:GetAttribute("OldHold") then
                    v.HoldDuration = v:GetAttribute("OldHold")
                    v:SetAttribute("OldHold", nil)
                end
            end
        end
    end
end)

-- B. Sprint Biasa (WalkSpeed 24)
task.spawn(function()
    while task.wait(0.1) do
        local char = lp.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then
            if State.Sprint then
                hum.WalkSpeed = 26 -- Kecepatan lari standar/biasa
            else
                if hum.WalkSpeed == 26 then hum.WalkSpeed = 16 end -- Kembali jalan normal
            end
        end
    end
end)

-- C. God Mode (Darah Tidak Berkurang)
RunService.RenderStepped:Connect(function()
    if State.GodMode then
        local char = lp.Character
        local hum = char and char:FindFirstChild("Humanoid")
        -- Jika health turun dari max, kembalikan instan ke max
        if hum and hum.Health < hum.MaxHealth and hum.Health > 0 then
            hum.Health = hum.MaxHealth
        end
    end
end)
