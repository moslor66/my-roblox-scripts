-- [[ 2. LOGIKA FITUR TRANSPORT ]]
local State = { Instant = false, Speed = false, Fullbright = false, InfJump = false, Noclip = false, DupePrompt = false }

local function AddToggle(text, stateKey, callback)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -5, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    b.Text = text .. " [OFF]"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseButton1Click:Connect(function()
        State[stateKey] = not State[stateKey]
        b.Text = text .. (State[stateKey] and " [ON]" or " [OFF]")
        b.BackgroundColor3 = State[stateKey] and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(50, 50, 55)
        if callback then callback(State[stateKey]) end
    end)
end

local function AddButton(text, callback)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -5, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(120, 80, 40) -- Warna beda untuk tombol eksekusi
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseButton1Click:Connect(function()
        -- Efek klik
        b.BackgroundColor3 = Color3.fromRGB(150, 100, 50)
        task.delay(0.1, function() b.BackgroundColor3 = Color3.fromRGB(120, 80, 40) end)
        if callback then callback() end
    end)
end

-- A. INSTANT INTERACT & DUPE PROMPT
AddToggle("⚡ Instant Interact", "Instant")
