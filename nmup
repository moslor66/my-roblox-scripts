ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt, player)
    if player == lp then
        if State.DupePrompt and fireproximityprompt then
            -- Spam 30x interact dalam 1 detik untuk menggandakan claim
            for i = 1, 30 do
                task.spawn(function()
                    fireproximityprompt(prompt)
                end)
            end
        elseif State.Instant then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
