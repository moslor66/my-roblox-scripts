-- C. SPEED LARI (Lebih Stabil)
local originalSpeed = 10
AddToggle("🏃 Speed Lari (Aman)", "Speed")
RunService.RenderStepped:Connect(function()
    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
    if hum then
        if State.Speed then
            if hum.WalkSpeed < 16 then
                originalSpeed = hum.WalkSpeed
                hum.WalkSpeed = 16
            end
        else
            if hum.WalkSpeed == 16 then
                hum.WalkSpeed = originalSpeed
            end
        end
    end
end)

-- D. FULLBRIGHT
local origAmbient, origOutdoorAmbient, origShadows
AddToggle("☀️ Fullbright", "Fullbright", function(isOn)
    if isOn then
        origAmbient = Lighting.Ambient
        origOutdoorAmbient = Lighting.OutdoorAmbient
        origShadows = Lighting.GlobalShadows
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
    else
        if origAmbient then
            Lighting.Ambient = origAmbient
            Lighting.OutdoorAmbient = origOutdoorAmbient
            Lighting.GlobalShadows = origShadows
        end
    end
end)

-- E. INFINITE JUMP
AddToggle("🦘 Infinite Jump", "InfJump")
UserInputService.JumpRequest:Connect(function()
    if State.InfJump then
        local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- F. NOCLIP
AddToggle("👻 Noclip", "Noclip")
RunService.Stepped:Connect(function()
    if State.Noclip and lp.Character then
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)
