-- ==========================================
-- 2. LOGIKA SCRIPT (ANTI FREEZE)
-- ==========================================
local isSpamming = false
local spamConnection = nil

CloseBtn.MouseButton1Click:Connect(function()
    if spamConnection then
        spamConnection:Disconnect()
    end
    ScreenGui:Destroy()
end)

SpamBtn.MouseButton1Click:Connect(function()
    if isSpamming then return end
    
    local targetCode = CodeInput.Text
    local remoteName = RemoteInput.Text
    
    if targetCode == "" or remoteName == "" then
        Status.Text = "Status: ⚠️ Isi Kodenya dulu!"
        Status.TextColor3 = Color3.fromRGB(255, 255, 50)
        return
    end

    -- Mencari RemoteFunction, bukan RemoteEvent
    local targetRemote = ReplicatedStorage:FindFirstChild(remoteName)

    if not targetRemote or not targetRemote:IsA("RemoteFunction") then
        Status.Text = "Status: ❌ RemoteFunction '".. remoteName .. "' tidak valid!"
        Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    isSpamming = true
    Status.Text = "Status: 🔥 MEMBORBARDIR SERVER (INVOKING)..."
    Status.TextColor3 = Color3.fromRGB(50, 255, 50)
    
    -- Loop render
    spamConnection = RunService.RenderStepped:Connect(function()
        -- WAJIB PAKAI TASK.SPAWN AGAR GAME TIDAK FREEZE KARENA INVOKESERVER
        task.spawn(function()
            pcall(function()
                targetRemote:InvokeServer(targetCode)
            end)
        end)
    end)
    
    -- Matikan otomatis setelah 2 detik
    task.delay(2, function()
        if spamConnection then
            spamConnection:Disconnect()
        end
        isSpamming = false
        Status.Text = "Status: ✅ Spam selesai! Cek apakah dapat itemnya."
        Status.TextColor3 = Color3.fromRGB(200, 200, 200)
    end)
end)
