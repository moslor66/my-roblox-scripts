-- [[ 4. FITUR BARU: SMOOTH MAGNET (BERDASARKAN RADIUS) ]]
task.spawn(function()
    while task.wait(0.5) do
        if State.SmoothMagnet and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = lp.Character.HumanoidRootPart
            
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj:FindFirstChildOfClass("TouchTransmitter") then
                    if not obj.Parent:FindFirstChild("Humanoid") then
                        -- Cek apakah puzzle berada di dalam batas radius
                        local distance = (myRoot.Position - obj.Position).Magnitude
                        if distance <= MaxRadius then
                            
                            -- Buat animasi magnet: Tarik puzzle melayang ke karakter dalam 0.3 detik
                            local magnetTweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
                            local magnetTween = TweenService:Create(obj, magnetTweenInfo, {CFrame = myRoot.CFrame})
                            
                            magnetTween:Play()
                            
                            -- Saat puzzle berhasil menempel di badan, tembak klaim sentuhan!
                            task.spawn(function()
                                magnetTween.Completed:Wait()
                                if obj and obj.Parent and firetouchinterest then
                                    firetouchinterest(myRoot, obj, 0)
                                    firetouchinterest(myRoot, obj, 1)
                                end
                            end)
                            
                            -- Jeda antar sedotan agar server tidak menganggapnya spam
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end
end)

-- [[ 5. AUTO-FLY FARM (Karakter menghampiri puzzle - Dipertahankan) ]]
local flySpeed = 80
task.spawn(function()
    while task.wait(0.5) do
        if State.AutoFarm and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = lp.Character.HumanoidRootPart
            local puzzles = {}
            
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj:FindFirstChildOfClass("TouchTransmitter") then
                    if not obj.Parent:FindFirstChild("Humanoid") then
                        local distance = (myRoot.Position - obj.Position).Magnitude
                        if distance <= MaxRadius then table.insert(puzzles, obj) end
                    end
                end
            end
            
            table.sort(puzzles, function(a, b)
                return (myRoot.Position - a.Position).Magnitude < (myRoot.Position - b.Position).Magnitude
            end)
            
            for _, obj in ipairs(puzzles) do
                if not State.AutoFarm then break end 
                
                if obj and obj.Parent then
                    local currentDist = (myRoot.Position - obj.Position).Magnitude
                    local flyTime = currentDist / flySpeed
                    
                    myRoot.Anchored = true
                    local targetPos = CFrame.new(obj.Position)
                    local tweenInfo = TweenInfo.new(flyTime, Enum.EasingStyle.Linear)
                    currentFlyTween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetPos})
                    currentFlyTween:Play()
                    currentFlyTween.Completed:Wait()
                    
                    myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    myRoot.Anchored = false
                    
                    if firetouchinterest then
                        firetouchinterest(myRoot, obj, 0)
                        firetouchinterest(myRoot, obj, 1)
                    end
                    task.wait(0.15)
                end
            end
        end
    end
end)
