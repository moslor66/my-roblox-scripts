-- [[ 2. PEMBUAT TOMBOL ]]
local State = { AutoFarm = false, SmoothMagnet = false, AntiAFK = false }
local radiusList = {50, 100, 150, 9999}
local radiusIndex = 2
local MaxRadius = radiusList[radiusIndex]

local function AddToggle(text, stateKey, colorOn)
    local b = Instance.new("TextButton", Content)
    b.Size = UDim2.new(1, -10, 0, 35); b.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
    b.Text = text .. " [OFF]"; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamSemibold
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    b.MouseButton1Click:Connect(function() 
        State[stateKey] = not State[stateKey]
        b.Text = text .. (State[stateKey] and " [ON]" or " [OFF]")
        b.BackgroundColor3 = State[stateKey] and colorOn or Color3.fromRGB(40, 45, 55)
        
        if stateKey == "AutoFarm" and not State.AutoFarm then
            if currentFlyTween then currentFlyTween:Cancel() end
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then 
                lp.Character.HumanoidRootPart.Anchored = false 
                lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
            end
        end
    end)
    return b
end

