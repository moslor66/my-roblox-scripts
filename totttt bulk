-- ==========================================
-- 2. LOGIKA SCRIPT (DATA & LOOP)
-- ==========================================
local isRunning = false

-- Data Argumen yang kamu berikan (sudah diperbaiki local-nya)
local args = {
    {
        {Id = "108833834533822", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "126318278374730", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "120765038724194", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "110054804831771", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "81413155908070", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "74238379316150", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "81406194447355", Type = Enum.MarketplaceProductType.AvatarAsset},
        {Id = "136070962098725", Type = Enum.MarketplaceProductType.AvatarAsset}
    }
}

-- Mencari RemoteEvent BulkPurchase
local remote = nil
pcall(function()
    remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BulkPurchase")
end)

-- Tombol Close (X)
CloseBtn.MouseButton1Click:Connect(function()
    isRunning = false
    ScreenGui:Destroy()
end)

-- Tombol ON / OFF
ToggleBtn.MouseButton1Click:Connect(function()
    if not remote then
        Status.Text = "Status: ❌ Remote tidak ditemukan!"
        Status.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    if isRunning then
        -- MATIKAN (OFF)
        isRunning = false
        ToggleBtn.Text = "▶ START (ON)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        Status.Text = "Status: OFF"
        Status.TextColor3 = Color3.fromRGB(200, 200, 200)
    else
        -- NYALAKAN (ON)
        isRunning = true
        ToggleBtn.Text = "🛑 STOP (OFF)"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        Status.Text = "Status: 🔥 ON (Membeli item...)"
        Status.TextColor3 = Color3.fromRGB(50, 255, 50)
        
        -- Loop pengiriman request
        task.spawn(function()
            while isRunning do
                pcall(function()
                    remote:FireServer(unpack(args))
                end)
                task.wait(0.1) -- Jeda aman agar tidak lag/kick
            end
        end)
    end
end)
