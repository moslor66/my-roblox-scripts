-- E. ENTITY ESP & WARNING ALERT
local IGNORED_NAMES = {
    "phone", "telephone", "door", "drawer", "table", "chair", "light", "lamp", 
    "locker", "cabinet", "shelf", "stretcher", "bed", "computer", "camera", 
    "morgue", "cart", "wheelchair", "box", "spawn", "desk", "clipboard", "key",
    "tool", "flashlight", "battery", "prop", "wall", "room", "floor", "button"
}

local function IsEntity(model)
    if not model:IsA("Model") or model == lp.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local nameLower = model.Name:lower()

    for _, ignore in ipairs(IGNORED_NAMES) do
        if nameLower:find(ignore) then return false end
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local anim = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Animator", true)
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")

    if (hum or anim) and root then return true end

    if (nameLower:find("monster") or nameLower:find("entity") or nameLower:find("ghost") or nameLower:find("creature") or nameLower:find("npc") or nameLower:find("anomaly") or nameLower:find("stalker")) and root then
        return true
    end

    return false
end

local function ClearEntityESP()
    EntityESPFolder:ClearAllChildren()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hl = obj:FindFirstChild("EntityHighlight")
            if hl then hl:Destroy() end
        end
    end
end

AddToggle("👹 Entity ESP & Alert", "EntityESP", function(isOn)
    if not isOn then 
        ClearEntityESP() 
        Title.Text = "TRANSPORTER V5"
        Title.TextColor3 = Color3.fromRGB(240, 240, 240)
    end
end)

local activeEntities = {}
task.spawn(function()
    while true do
        if State.EntityESP then
            local found = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and IsEntity(obj) then
                    table.insert(found, obj)
                end
            end
            activeEntities = found
        end
        task.wait(0.5)
    end
end)

Connections.EntityLoop = RunService.Heartbeat:Connect(function()
    if not State.EntityESP then return end
    
    local myRoot = lp.Character and (lp.Character:FindFirstChild("HumanoidRootPart") or lp.Character:FindFirstChild("Head"))
    local nearbyAlert = false
    local currentTags = {}
    
    for _, obj in ipairs(activeEntities) do
        if obj and obj.Parent then
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj.PrimaryPart
            if root then
                local hl = obj:FindFirstChild("EntityHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "EntityHighlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 50)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.3
                    hl.Adornee = obj
                    hl.Parent = obj
                end
                
                local tagName = obj.Name .. "_" .. obj:GetDebugId()
                local tag = EntityESPFolder:FindFirstChild(tagName)
                if not tag then
                    tag = Instance.new("BillboardGui", EntityESPFolder)
                    tag.Name = tagName
                    tag.Size = UDim2.new(0, 140, 0, 30)
                    tag.AlwaysOnTop = true
                    
                    local txt = Instance.new("TextLabel", tag)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 60, 60)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                end
                
                currentTags[tagName] = true
                tag.Adornee = root
                
                if myRoot then
                    local dist = math.floor((myRoot.Position - root.Position).Magnitude)
                    tag.TextLabel.Text = "⚠️ " .. obj.Name .. " [" .. dist .. "m]"
                    if dist <= 40 then nearbyAlert = true end
                end
            end
        end
    end
    
    for _, tag in ipairs(EntityESPFolder:GetChildren()) do
        if not currentTags[tag.Name] then
            tag:Destroy()
        end
    end
    
    if nearbyAlert then
        Title.Text = "⚠️ MONSTER DEKAT! ⚠️"
        Title.TextColor3 = Color3.fromRGB(255, 50, 50)
    else
        Title.Text = "TRANSPORTER V5"
        Title.TextColor3 = Color3.fromRGB(240, 240, 240)
    end
end)

